NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
GEMINI_API_KEY=AIza...

# AdMob (set these once you've created an AdMob account + ad units —
# until then the app falls back to Google's public test ad units, see
# src/lib/ads/admob.ts)
NEXT_PUBLIC_ADMOB_BANNER_ID=
NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID=
NEXT_PUBLIC_ADMOB_REWARDED_ID=

# SMS provider for reminders (see src/lib/reminders/smsProvider.ts — logs
# to console instead of sending until these are set)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USER_ID=
SMS_PROVIDER_SENDER_ID=ProfitSnap

# PayHere (Visa/Mastercard/Amex checkout — see src/lib/payments/payhere.ts)
# Get these from your PayHere merchant dashboard: Settings → Domains & Credentials.
# Until both are set, card checkout is unavailable and Settings falls back
# to the manual "Request" (admin-confirmed) flow automatically.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Used to build PayHere's return/cancel/notify URLs. Set to your real
# domain (e.g. https://profitsnap-lk.vercel.app) in production — falls
# back to the request's own origin if unset.
NEXT_PUBLIC_APP_URL=

# Google Play Billing (native Android subscriptions — see
# android-native's BillingRepository and this route's verify endpoint).
# Dialog carrier billing appears automatically as a Play Store payment
# option once this is wired up — no separate Dialog integration needed
# for the Android subscription path.
# Create this service account in Google Cloud Console → IAM, grant it
# "Service Account User" on your Play Console under Setup → API access,
# then paste the full JSON key content here (as one line, or a file path
# if your deploy target supports mounting files).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=lk.profitsnap.native

# Dialog Direct Carrier Billing — GSMA Open Gateway / CAMARA Carrier
# Billing API (see src/lib/payments/dialogCarrierBilling.ts). This is a
# SEPARATE thing from Google Play Billing above — it's for charging a
# subscriber's Dialog account directly from the web app, without going
# through an app store. Requires registering as a developer/merchant on
# Dialog's Open Gateway / Ideamart portal first — these values don't exist
# until that registration is approved and Dialog issues you real
# credentials + a sandbox endpoint.
DIALOG_CARRIER_BILLING_CLIENT_ID=
DIALOG_CARRIER_BILLING_CLIENT_SECRET=
DIALOG_CARRIER_BILLING_API_BASE_URL=
